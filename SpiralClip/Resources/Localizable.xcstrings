    "clip.page.privacy.subtitle": {
      "comment": "App Clip tour page 2: messages are encrypted; the assistant acts only with permission.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Encrypted, and AI only with your permission"
          }
        },
        "uk": {
          "stringUnit": {
