			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>One untranslated item</string>
			<key>other</key>
			<string>%d untranslated items</string>
		</dict>
	</dict>
