// swiftformat:disable all

extension AccessibilityTests {
    /// The previews that conform to `SpiralGatedPreview`.
    static let spiralGatedPreviews: Set<String> = [
        {% for type in types.types where type.implements.SpiralGatedPreview and type.implements.TestablePreview and type.kind != "protocol" %}
        "{{ type.name }}",
        {% endfor %}
    ]
}

// swiftlint:enable all
// swiftformat:enable all
